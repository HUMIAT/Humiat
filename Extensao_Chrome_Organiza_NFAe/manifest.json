{
  "manifest_version": 3,
  "name": "Organiza NFA-e",
  "version": "1.0.23",
  "description": "Fluxo automático NFA-e 1.0.23: orienta e valida a primeira tela (Saída/Interna ou Interestadual/Venda de Mercadoria) antes de seguir e aplica CFOP 5102/6102 conforme UF.",
  "permissions": [
    "storage",
    "tabs",
    "webNavigation"
  ],
  "host_permissions": [
    "https://humiat.com.br/*",
    "https://www.humiat.com.br/*",
    "https://svp-extranet.svrs.rs.gov.br/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://humiat.com.br/*",
        "https://www.humiat.com.br/*"
      ],
      "js": [
        "organiza_bridge.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://svp-extranet.svrs.rs.gov.br/*"
      ],
      "js": [
        "sefaz_fill.js"
      ],
      "run_at": "document_idle",
      "all_frames": true
    }
  ]
}
