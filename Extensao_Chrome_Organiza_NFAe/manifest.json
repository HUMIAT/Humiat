{
  "manifest_version": 3,
  "name": "Organiza NFA-e",
  "version": "1.0.2",
  "description": "Preenche a NFA-e por aba com dados do Organiza, sem alterar o emitente e com tratamento separado de CPF/CNPJ.",
  "permissions": [
    "storage",
    "tabs"
  ],
  "host_permissions": [
    "https://humiat.com.br/*",
    "https://www.humiat.com.br/*",
    "https://svp-extranet.svrs.rs.gov.br/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://humiat.com.br/*",
        "https://www.humiat.com.br/*"
      ],
      "js": [
        "organiza_bridge.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://svp-extranet.svrs.rs.gov.br/*"
      ],
      "js": [
        "sefaz_fill.js"
      ],
      "run_at": "document_idle",
      "all_frames": true
    }
  ]
}
