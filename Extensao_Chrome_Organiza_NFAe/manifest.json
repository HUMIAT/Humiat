{
  "manifest_version": 3,
  "name": "Organiza NFA-e",
  "version": "1.0.67",
  "description": "Fluxo automático NFA-e 1.0.67: mantém Produto, Sem frete e Pagamento; após o pagamento salvo, clica somente no botão global Validar e encerra. Suporta endereço de entrega diferente enviado pelo Organiza; não abre Observação, não clica Salvar/Emitir, não responde popup e não inicia nova NF-e.",
  "permissions": [
    "storage",
    "tabs",
    "webNavigation",
    "scripting"
  ],
  "host_permissions": [
    "https://humiat.com.br/*",
    "https://www.humiat.com.br/*",
    "https://svp-extranet.svrs.rs.gov.br/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://humiat.com.br/*",
        "https://www.humiat.com.br/*"
      ],
      "js": [
        "organiza_bridge.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://svp-extranet.svrs.rs.gov.br/*"
      ],
      "js": [
        "sefaz_main.js"
      ],
      "run_at": "document_start",
      "all_frames": true,
      "world": "MAIN"
    },
    {
      "matches": [
        "https://svp-extranet.svrs.rs.gov.br/*"
      ],
      "js": [
        "sefaz_fill.js"
      ],
      "run_at": "document_idle",
      "all_frames": true
    }
  ]
}
