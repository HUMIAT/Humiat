{
  "manifest_version": 3,
  "name": "Organiza NFA-e",
  "version": "1.0.21",
  "description": "Fluxo automático NFA-e 1.0.21: preserva estado entre frames, navega abas automaticamente, valida/salva produto, abre pagamento, preenche sem frete e impede CFOP estadual para destinatário interestadual.",
  "permissions": [
    "storage",
    "tabs",
    "webNavigation"
  ],
  "host_permissions": [
    "https://humiat.com.br/*",
    "https://www.humiat.com.br/*",
    "https://svp-extranet.svrs.rs.gov.br/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://humiat.com.br/*",
        "https://www.humiat.com.br/*"
      ],
      "js": [
        "organiza_bridge.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://svp-extranet.svrs.rs.gov.br/*"
      ],
      "js": [
        "sefaz_fill.js"
      ],
      "run_at": "document_idle",
      "all_frames": true
    }
  ]
}