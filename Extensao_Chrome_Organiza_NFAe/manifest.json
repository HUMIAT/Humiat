{
  "manifest_version": 3,
  "name": "Organiza Fiscal",
  "version": "1.0.68",
  "description": "Organiza Fiscal 1.0.68: mantém a automação NFA-e e adiciona preparação de rascunho NFS-e no Emissor Nacional, sempre parando antes da emissão final.",
  "permissions": [
    "storage",
    "tabs",
    "webNavigation",
    "scripting"
  ],
  "host_permissions": [
    "https://humiat.com.br/*",
    "https://www.humiat.com.br/*",
    "https://svp-extranet.svrs.rs.gov.br/*",
    "https://www.nfse.gov.br/*",
    "https://nfse.gov.br/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://humiat.com.br/*",
        "https://www.humiat.com.br/*"
      ],
      "js": [
        "organiza_bridge.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://svp-extranet.svrs.rs.gov.br/*"
      ],
      "js": [
        "sefaz_main.js"
      ],
      "run_at": "document_start",
      "all_frames": true,
      "world": "MAIN"
    },
    {
      "matches": [
        "https://svp-extranet.svrs.rs.gov.br/*"
      ],
      "js": [
        "sefaz_fill.js"
      ],
      "run_at": "document_idle",
      "all_frames": true
    },
    {
      "matches": [
        "https://www.nfse.gov.br/EmissorNacional/*",
        "https://nfse.gov.br/EmissorNacional/*"
      ],
      "js": [
        "nfse_draft.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
