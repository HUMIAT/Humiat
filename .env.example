# Local: pode deixar DATABASE_URL vazio para usar SQLite em organiza.db
# Render/Neon: cole a string completa do Neon em DATABASE_URL
DATABASE_URL=

SECRET_KEY=troque-por-uma-chave-grande
ORGANIZA_ADMIN_NOME=Admin
ORGANIZA_ADMIN_SENHA=troque-esta-senha

# Token compartilhado somente entre LokaFest e Organiza
LOKAFEST_API_TOKEN=troque-por-um-token-longo-e-secreto

# Humiat ID
HUMIAT_ADMIN_EMAIL=admin@humiat.com.br
HUMIAT_ADMIN_NOME=Administrador Humiat
HUMIAT_ADMIN_SENHA=troque-por-uma-senha-forte
HUMIAT_SESSION_DAYS=1
HUMIAT_SSO_SECRET=gere-um-segredo-longo-e-unico
HUMIAT_CONNECT_URL=https://conect.humiat.com.br
HUMIAT_CONNECT_SSO_URL=https://conect.humiat.com.br/_connect/sso/humiat
HUMIAT_LOKAFEST_URL=https://lokafest.com.br
HUMIAT_LOKAFEST_SSO_URL=
HUMIAT_SOLVOZ_URL=https://www.solvoz.com.br
HUMIAT_SOLVOZ_SSO_URL=https://www.solvoz.com.br/_sv/sso/humiat
HUMIAT_SOLVOZ_API_TIMEOUT=8

# Integração privada Organiza -> SolVoz (usar o mesmo valor no SolVoz)
# O Organiza envia cadastro/equipamentos; o SolVoz cria a senha provisória e o Organiza a entrega pelo Resend.
SOLVOZ_API_TOKEN=
SOLVOZ_BASE_URL=https://www.solvoz.com.br
SOLVOZ_API_TIMEOUT=12

# E-mails do HUMIAT/Organiza por HTTPS (Resend).
# Este transporte também envia a senha provisória e a recuperação de senha do SolVoz.
HUMIAT_RESET_MINUTES=30
HUMIAT_RESEND_API_KEY=
# Após verificar o domínio humiat.com.br no Resend, use por exemplo:
HUMIAT_EMAIL_FROM=Humiat <acesso@humiat.com.br>

# Logout global / páginas públicas dos produtos
HUMIAT_CONNECT_LOGOUT_URL=https://conect.humiat.com.br/_connect/logout-humiat
HUMIAT_SOLVOZ_LOGOUT_URL=https://www.solvoz.com.br/_sv/logout-humiat
HUMIAT_CONNECT_PRODUTO_URL=https://conect.humiat.com.br
HUMIAT_SOLVOZ_PRODUTO_URL=https://www.solvoz.com.br
HUMIAT_LOKAFEST_PRODUTO_URL=https://lokafest.com.br
